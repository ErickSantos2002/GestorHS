DATABASE_URL=postgresql+psycopg2://usuario:TROCAR_SENHA@localhost:5432/gestorhs-banco
JWT_SECRET_KEY=troque-por-uma-chave-aleatoria-de-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Pasta de uploads (fotos/PDFs). Em produção, monte um volume e aponte para ele (ex.: /data/uploads).
UPLOAD_DIR=uploads
# Onde os scripts de integracao gravam o CSV de pendencias.
# Vazio (recomendado) = {UPLOAD_DIR}/relatorios, o volume persistente que ja existe.
# So preencha para gravar o relatorio em outro lugar.
RELATORIOS_DIR=
# Integracao com o TaskHS (opcional; vazio = desligada)
TASKHS_BASE_URL=
TASKHS_API_KEY=
# Base publica do backend para o link de download do certificado no card do TaskHS (vazio = sem link)
CERT_PUBLIC_BASE_URL=

# Worker diario do GrowthHS (cards de calibracao vencendo em 50 dias).
# DESLIGADO por padrao de proposito: a maquina de desenvolvimento aponta para o banco
# de producao com a chave real. Ligue SO no ambiente de producao.
JOB_VENCENDO_ATIVO=false
JOB_VENCENDO_HORA=8
JOB_VENCENDO_DIAS=50

# SSO Microsoft (Entra ID). Vazio = desligado (mesmo gating do TaskHS/GrowthHS):
# o botao "Entrar com Microsoft" some da tela de login e GET /auth/microsoft responde 503.
# App Registration proprio do GestorHS, single tenant, permissao delegada User.Read.
MS_CLIENT_ID=
MS_TENANT_ID=
MS_CLIENT_SECRET=
# Sem /api no caminho: o router e' APIRouter(prefix="/auth") e o main.py nao monta prefixo.
# Producao: https://gestorhsapi.healthsafetytech.com/auth/microsoft/callback
MS_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback
# Para onde o callback redireciona depois de autenticar. Producao: https://gestorhs.healthsafetytech.com
FRONTEND_URL=http://localhost:5173

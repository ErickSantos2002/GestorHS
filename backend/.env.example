DATABASE_URL=postgresql+psycopg2://usuario:TROCAR_SENHA@localhost:5432/gestorhs-banco
JWT_SECRET_KEY=troque-por-uma-chave-aleatoria-de-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Pasta de uploads (fotos/PDFs). Em produção, monte um volume e aponte para ele (ex.: /data/uploads).
UPLOAD_DIR=uploads
# Onde os scripts de integracao gravam o CSV de pendencias.
# Vazio = backend/relatorios/ (serve em dev, que monta ./backend no container).
# Em PRODUCAO a imagem sobe pelo Dockerfile SEM bind mount: aponte para o volume
# persistente, ex. RELATORIOS_DIR=/data/uploads/relatorios
RELATORIOS_DIR=
# Integracao com o TaskHS (opcional; vazio = desligada)
TASKHS_BASE_URL=
TASKHS_API_KEY=
# Base publica do backend para o link de download do certificado no card do TaskHS (vazio = sem link)
CERT_PUBLIC_BASE_URL=
